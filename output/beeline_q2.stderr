INFO  : Completed compiling command(queryId=hive_20260510184027_d90804ab-0755-4669-90dd-f00737cac00e); Time taken: 0.651 seconds
INFO  : Executing command(queryId=hive_20260510184027_d90804ab-0755-4669-90dd-f00737cac00e): WITH ua_pairs AS (
SELECT
i.user_id,
t.artists  AS artist,
COUNT(*)   AS pos_count
FROM interactions_part i
JOIN tracks_part       t ON i.item_id = t.id
WHERE i.interaction_flag = 1
GROUP BY i.user_id, t.artists
),
binned AS (
SELECT CASE WHEN pos_count >= 10 THEN 10 ELSE pos_count END AS bucket
FROM ua_pairs
)
INSERT OVERWRITE TABLE q2_results
SELECT
bucket                                              AS positives_per_user_artist,
COUNT(*)                                            AS pair_count,
ROUND(100.0 * COUNT(*) / SUM(COUNT(*)) OVER (), 4)  AS pct
FROM binned
GROUP BY bucket
ORDER BY bucket
